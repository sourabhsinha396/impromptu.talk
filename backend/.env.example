DJANGO_SETTINGS_MODULE=impromptu.settings.local
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
WEB_PORT=8009

# Postgres, from `docker compose up` in backend/. The host is the compose
# network name; nothing is published on the host, so this stack never
# collides with a neighbouring project's. Production refuses to boot
# without a host.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=impromptu
POSTGRES_USER=impromptu
POSTGRES_PASSWORD=impromptu

FRONTEND_ORIGIN=FRONTEND_ORIGIN

# Rate-limit counters, in the compose redis service. Empty means in-process
# memory, which only ever suits a single process.
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# Mail. Empty prints every message to the container's log instead of
# sending it; set the key to send through Brevo. The from address is what
# a reset link arrives from.
BREVO_API_KEY=
MAIL_FROM_ADDRESS=no-reply@impromptu.talk

# Google sign-in. Empty means off: the button is not drawn and its routes
# 404. The callback URL to register with Google is
# FRONTEND_ORIGIN + /api/v1/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# reCAPTCHA v2 on signup, login and forgot. Empty means off: no widget,
# every submission passes. Fails open on top of that: an unreachable
# verifier degrades to the site as it was before the captcha existed.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# The payment provider (card 24). No key means nothing is for sale: Pro is
# not linked anywhere and no feature is gated. Each plan needs its own
# dashboard product id too, and a missing one switches that plan off.
# Prices are not here; they are code, in apps/payments/plans.py.
DODO_API_KEY=
# https://test.dodopayments.com (the default when this is empty) or
# https://live.dodopayments.com. The key and the host have to match: a
# live key against the sandbox fails every call.
DODO_BASE_URL=
DODO_PRODUCT_MONTHLY=
DODO_PRODUCT_ANNUAL=
DODO_PRODUCT_PASS=
DODO_PRODUCT_LIFETIME=

SLACK_WEBHOOK_URL=

# Generating topics from a sentence, on the genre editor. Empty means off:
# the pane is not drawn and the route 404s. Set a hard spend limit on the
# key in the provider's dashboard; the five-a-month allowance in
# apps/topics/generate.py is the first cap and that is the second.
OPENROUTER_API_KEY=
# https://openrouter.ai/api/v1 when empty.
OPENROUTER_BASE_URL=
# google/gemini-2.5-flash-lite when empty. Nothing here is graded, so a
# stronger model is only dearer.
OPENROUTER_MODEL=
