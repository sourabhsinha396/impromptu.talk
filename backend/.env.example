DJANGO_SETTINGS_MODULE=impromptu.settings.local
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
WEB_PORT=8008

# Postgres, from `docker compose up db` at the repo root. The host is the
# loopback address compose publishes; compose's own `api` service overrides
# it with the network name `db`. Production refuses to boot without a host.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=impromptu
POSTGRES_USER=impromptu
POSTGRES_PASSWORD=impromptu

# Where the frontend answers; empty means the dev server on 3008.
FRONTEND_ORIGIN=

# Rate-limit counters. Empty means in-process memory, which is right for one
# process on a laptop; compose points its api at the redis service instead.
RATELIMIT_STORAGE_URI=
