DJANGO_SETTINGS_MODULE=yapholic.settings.local
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
WEB_PORT=8009

# Postgres, from `docker compose up` in backend/. The host is the compose
# network name; nothing is published on the host, so this stack never
# collides with a neighbouring project's. Production refuses to boot
# without a host.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=yapholic
POSTGRES_USER=yapholic
POSTGRES_PASSWORD=yapholic

FRONTEND_ORIGIN=FRONTEND_ORIGIN

# Rate-limit counters, in the compose redis service. Empty means in-process
# memory, which only ever suits a single process.
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# Mail. Empty prints every message to the container's log instead of
# sending it; set the key to send through Brevo. The from address is what
# a reset link arrives from.
BREVO_API_KEY=
MAIL_FROM_ADDRESS=no-reply@yapholic.com

# Google sign-in. Empty means off: the button is not drawn and its routes
# 404. The callback URL to register with Google is
# FRONTEND_ORIGIN + /api/v1/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# reCAPTCHA v2 on signup, login and forgot. Empty means off: no widget,
# every submission passes. Fails open on top of that: an unreachable
# verifier degrades to the site as it was before the captcha existed.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# The payment provider (card 24). Required in production, which refuses to
# boot without it: `is_pro` is read before every billable call, so a host
# that forgot its .env must not be the thing that decides who is entitled
# to one. No key in development means nothing is for sale and Pro is not
# linked anywhere; it no longer means everybody has Pro, so grant it by
# hand with a complimentary purchase when you need it locally. Each plan
# needs its own dashboard product id too, and a missing one switches that
# plan off. Prices are not here; they are code, in apps/payments/plans.py.
DODO_API_KEY=
# https://test.dodopayments.com (the default when this is empty) or
# https://live.dodopayments.com. The key and the host have to match: a
# live key against the sandbox fails every call.
DODO_BASE_URL=
DODO_PRODUCT_MONTHLY=
DODO_PRODUCT_ANNUAL=
DODO_PRODUCT_PASS=
DODO_PRODUCT_LIFETIME=

SLACK_WEBHOOK_URL=

# Static files (the admin's own CSS and JS included), served from an
# S3-compatible bucket behind a CDN. Required in production, which
# refuses to boot without them: base.py's own fallback is Django serving
# them off the process's own disk, which is how the admin ends up with no
# styling. Empty in development, where Django's staticfiles app serves
# them off disk with no collecting needed. The endpoint is empty for AWS's
# own S3 and set for an S3-compatible provider such as R2 or Spaces.
STORAGE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
STORAGE_PUBLIC_BASE_URL=

# Generating topics from a sentence, on the genre editor. Empty means off:
# the pane is not drawn and the route 404s. Set a hard spend limit on the
# key in the provider's dashboard; the five-a-month allowance in
# apps/topics/generate.py is the first cap and that is the second.
OPENROUTER_API_KEY=
# https://openrouter.ai/api/v1 when empty.
OPENROUTER_BASE_URL=
# google/gemini-2.5-flash-lite when empty. Nothing here is graded, so a
# stronger model is only dearer.
OPENROUTER_MODEL=

# The delivery report's two transcribers, one per tier. Timing (pauses,
# the opening stall, trail-off) is measured in the browser and needs
# neither of these; only the words cost money, and they are metered by
# apps/runs/reports.py at five minutes a month free and two hours on Pro.
# Whisper-large-v3-turbo, and Whisper normalises "um" and "uh" away, which
# is why the free tier honestly shows no filler count.
GROQ_API_KEY=
# AssemblyAI, called with disfluencies on. That flag is the whole reason
# Pro uses a second provider: it detects 0.987 of fillers on non-native
# English where Deepgram manages 0.713. Blank drops Pro to timing only.
ASSEMBLY_AI_API_KEY=
