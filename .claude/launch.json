    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "manage.py", "runserver", "8008", "--settings=impromptu.settings.local"],
      "cwd": "backend",
      "port": 8008
    }
  ]
}
