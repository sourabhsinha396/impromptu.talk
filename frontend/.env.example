BACKEND_ORIGIN=http://127.0.0.1:8009

# The site's own origin, for canonical URLs, the sitemap and JSON-LD.
# No trailing slash. Unset falls back to the dev port rather than a domain,
# so a host that forgot this does not publish a wrong one.
NEXT_PUBLIC_SITE_URL=

# Who the site says it is: the name beside the copyright (empty means the
# site name) and the address the footer, contact page and legal pages print.
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_EMAIL=

# Read the visitor's country from the CF-IPCountry header. Only 1 behind
# Cloudflare, which sets it; anywhere else the header is visitor-supplied.
TRUST_COUNTRY_HEADER=
