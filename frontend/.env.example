BACKEND_ORIGIN=http://127.0.0.1:8009

# The site's own origin, for canonical URLs, the sitemap and JSON-LD.
# No trailing slash. Unset falls back to the dev port rather than a domain,
# so a host that forgot this does not publish a wrong one.
NEXT_PUBLIC_SITE_URL=

# Who the site says it is: the name beside the copyright (empty means the
# site name) and the address the footer, contact page and legal pages print.
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_EMAIL=

# Analytics. On only when this says production and a token is set below;
# anything else, or an empty token, sends nothing. It is a word in .env
# rather than the build mode so a production build run on a laptop is not
# traffic, and so flipping this one line is how you watch your own events.
DEBUG_ENV=

# The project token is a public key: it ships in the page, which is what it
# is for. The host is where PostHog's own script and its events go; empty
# means the US cloud.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Support chat. The website id is public too: it names the inbox a message
# lands in. Empty means no chat. It is never drawn on the home page.
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Google sign-in. Whether the button is drawn on /login and /signup. A
# client id is public by design (it ships in the OAuth redirect a browser
# makes), so this mirrors it rather than gating on a secret the frontend
# never sees; the backend's own key pair is what actually turns the door
# on and is set separately in backend/.env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# reCAPTCHA v2. Whether the checkbox is drawn on /signup, /login and
# /forgot. A site key is public by design (it ships to the browser so
# Google's widget can draw itself); the backend's own site/secret pair is
# what actually verifies a token and is set separately in backend/.env.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
